# Server-only application configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=make_my_marriage
# Required: use a unique random value with at least 32 bytes of entropy.
AUTH_TOKEN_PEPPER=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configure only when implementing these integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GOOGLE_MAPS_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Local developer tool: Google Stitch MCP (keep the real key in .env.local)
STITCH_API_KEY=
